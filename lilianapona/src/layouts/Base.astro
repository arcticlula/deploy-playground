---
/**
 * The frame of every page: <head>, side menu, header, footer and search overlay.
 * Page content goes in the slot.
 */
import '../styles/base.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Footer from '../components/Footer.astro';
import HomeHeader from '../components/HomeHeader.astro';
import MenuPanel from '../components/MenuPanel.astro';
import PageHeader from '../components/PageHeader.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import defaultShareImage from '../assets/images/home/hero-model.png';
import { site } from '../data/site';
import { base, defaultLang, htmlLang, languages, pagePath, withBase, type Lang, type PageRef } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Which page this is: gives the canonical address and the links of the language switch. Leave out on the 404 page. */
  page?: PageRef;
  /** Shown in the browser tab as "Title – Liliana Pona Jewellery". Leave out on the home page. */
  title?: string;
  /** Short summary for search engines. Falls back to the site description in ui.ts. */
  description?: string;
  /** "home" is the header without logo used on the home page. */
  header?: 'home' | 'page';
  /** Picture shown when the page is shared on social networks. */
  shareImage?: ImageMetadata;
  /** Ask search engines not to list this page. */
  noindex?: boolean;
}

const { lang, page, title, description, header = 'page', shareImage = defaultShareImage, noindex = false } = Astro.props;
const t = useTranslations(lang);

const origin = Astro.site ?? new URL(site.url);
const absolute = (path: string) => new URL(path, origin).href;

// A copy built for another address (a preview, see astro.config.mjs) must not compete with the real site in search results.
const isPreview = base !== '';

const fullTitle = title ? `${title} – ${site.name}` : site.name;
const metaDescription = description ?? t.meta.defaultDescription;
const canonical = page ? absolute(pagePath(page, lang)) : undefined;
const share = await getImage({ src: shareImage, width: Math.min(1200, shareImage.width), format: 'jpeg', quality: 82 });
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {(noindex || isPreview) && <meta name="robots" content="noindex" />}

    {canonical && <link rel="canonical" href={canonical} />}
    {
      page &&
        languages.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={absolute(pagePath(page, l))} />)
    }
    {page && <link rel="alternate" hreflang="x-default" href={absolute(pagePath(page, defaultLang))} />}

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={htmlLang[lang].replace('-', '_')} />
    <meta property="og:image" content={absolute(share.src)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" />
    <link rel="icon" href={withBase('/favicon-192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#ffffff" />
  </head>

  <body>
    <a class="lp-skip-link" href="#main">{t.skipToContent}</a>

    <MenuPanel lang={lang} />

    {header === 'home' ? <HomeHeader lang={lang} page={page} /> : <PageHeader lang={lang} page={page} />}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />
    <SearchOverlay lang={lang} />

    <script>
      import '../scripts/ajax-form';
    </script>
  </body>
</html>
